# Copie a configuração gerada por npm run setup. Nunca publique segredos.
SITE_URL=http://localhost:3000
DATABASE_PATH=private/bahia.sqlite
# PostgreSQL na Vercel (SQLite só para desenvolvimento local).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Origem HTTPS adicional exata, por exemplo o alias de produção Vercel.
ADDITIONAL_SITE_ORIGIN=
DATA_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
DATA_CONTROLLER=José Carlos Guilherme Santos — Professor Guilherme
PRIVACY_EMAIL=profguilherme_254@hotmail.com
PRIVACY_REVIEWED=false
RETENTION_DAYS=365
COLLECTION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Obrigatório para abrir a coleta: habilite apenas no host de produção após
# confirmar que o proxy confiável sobrescreve X-Forwarded-For com o IP do cliente.
# Sem essa configuração, a coleta permanece fechada; nunca confie em X-Forwarded-For arbitrário.
TRUST_PROXY=false
# Em produção Vercel, páginas públicas são indexáveis por padrão.
# false bloqueia a indexação; previews/local ficam bloqueados sem opt-in.
# PUBLIC_INDEXING_ENABLED=false
